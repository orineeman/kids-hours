{
  "name": "kids-hours-cloud",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute kids-hours --local --file=migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute kids-hours --remote --file=migrations/0001_init.sql",
    "device:create": "node scripts/create-device.js",
    "migrate:from-local-db": "node scripts/migrate-local-to-d1.js"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
